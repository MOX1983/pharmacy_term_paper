<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="343.0" prefWidth="588.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pharmacy.DelePills">
   <children>
      <TableView fx:id="table_data" layoutY="73.0" prefHeight="269.0" prefWidth="588.0">
         <columns>
            <TableColumn fx:id="Name" prefWidth="105.0" text=" Название" />
            <TableColumn fx:id="Description" prefWidth="203.0" text="Описание" />
            <TableColumn fx:id="Quantity" minWidth="0.0" prefWidth="109.0" text="Количество" />
            <TableColumn fx:id="Date" minWidth="0.0" prefWidth="185.0" text="Срок годности партии" />
         </columns>
      </TableView>
      <Label layoutX="21.0" layoutY="14.0" text="Причина удалния ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <RadioButton fx:id="end" layoutX="139.0" layoutY="16.0" mnemonicParsing="false" text="Закончилось">
         <toggleGroup>
            <ToggleGroup fx:id="reason" />
         </toggleGroup>
         <font>
            <Font size="14.0" />
         </font>
      </RadioButton>
      <RadioButton fx:id="expired" layoutX="139.0" layoutY="43.0" mnemonicParsing="false" text="Истёк срок годноости " toggleGroup="$reason">
         <font>
            <Font size="14.0" />
         </font></RadioButton>
      <RadioButton fx:id="other" layoutX="322.0" layoutY="12.0" mnemonicParsing="false" text="Другое" toggleGroup="$reason">
         <font>
            <Font size="14.0" />
         </font>
      </RadioButton>
      <TextField fx:id="text_other" layoutX="404.0" layoutY="10.0" />
      <Button fx:id="dele_b" layoutX="493.0" layoutY="39.0" mnemonicParsing="false" text="Удалить" />
   </children>
</AnchorPane>
