<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pharmacy.MainClass">
   <top>
      <MenuBar fx:id="manubar" prefHeight="25.0" prefWidth="388.0" BorderPane.alignment="CENTER">
        <menus>
          <Menu fx:id="All_pharm" mnemonicParsing="false" text="Сортировка">
               <items>
                  <RadioMenuItem fx:id="sort_A_Z" mnemonicParsing="false" text="По алфавиту (А-Я)">
                     <toggleGroup>
                        <ToggleGroup fx:id="sort" />
                     </toggleGroup>
                  </RadioMenuItem>
                  <RadioMenuItem fx:id="sort_Z_A" mnemonicParsing="false" text="По алфавиту (Я-А)" toggleGroup="$sort" />
               </items>
          </Menu>
          <Menu fx:id="actions" mnemonicParsing="false" text="Действие">
               <items>
                  <MenuItem fx:id="add_pharm" mnemonicParsing="false" text="Добавить партию" />
                  <MenuItem fx:id="delete_pharm" mnemonicParsing="false" text="Удалить партию" />
               </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <TableView fx:id="table_data" prefHeight="375.0" prefWidth="521.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="Name" prefWidth="237.0" text=" Название" />
          <TableColumn fx:id="Quantity" minWidth="0.0" prefWidth="92.0" text="Количество" />
            <TableColumn fx:id="Date" minWidth="0.0" prefWidth="270.0" text="Срок годности партии" />
        </columns>
      </TableView>
   </center>
</BorderPane>
